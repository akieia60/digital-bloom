# ============================================================
# Digital Bloom — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# Add all these variables to your Vercel project settings.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-side only, never expose to frontend

# ── Stripe ───────────────────────────────────────────────────
# Test keys start with sk_test_ and pk_test_
# Live keys start with sk_live_ and pk_live_
STRIPE_SECRET_KEY=sk_test_your-secret-key-here          # Server-side only
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ── Stripe Pricing Tiers ─────────────────────────────────────
# Run scripts/setup-stripe-products.js to generate these IDs.
# Then paste the output here and in Vercel environment variables.

# Tier 1 — Single Bloom ($1.99)
VITE_STRIPE_PRODUCT_TIER1=prod_REPLACE_AFTER_SETUP
VITE_STRIPE_PRICE_TIER1=price_REPLACE_AFTER_SETUP

# Tier 2 — Bloom Experience ($4.99)
VITE_STRIPE_PRODUCT_TIER2=prod_REPLACE_AFTER_SETUP
VITE_STRIPE_PRICE_TIER2=price_REPLACE_AFTER_SETUP

# Tier 3 — Premium Bloom ($9.99)
VITE_STRIPE_PRODUCT_TIER3=prod_REPLACE_AFTER_SETUP
VITE_STRIPE_PRICE_TIER3=price_REPLACE_AFTER_SETUP

# Tier 4 — Signature Collection ($19.99)
VITE_STRIPE_PRODUCT_TIER4=prod_REPLACE_AFTER_SETUP
VITE_STRIPE_PRICE_TIER4=price_REPLACE_AFTER_SETUP

# ── App URLs ─────────────────────────────────────────────────
APP_BASE_URL=https://your-app.vercel.app
VITE_STRIPE_SUCCESS_URL=https://your-app.vercel.app/success
VITE_STRIPE_CANCEL_URL=https://your-app.vercel.app

# ── Buffer Marketing Queue ───────────────────────────────────
# Used by /api/admin/buffer to queue Ak-approved marketing videos.
BUFFER_API_KEY=your-buffer-api-key-here
BUFFER_ORGANIZATION_ID=optional-buffer-organization-id
BUFFER_CHANNEL_IDS=optional-channel-id-1,optional-channel-id-2
CRON_SECRET=change-this-to-a-random-string

# ── Twilio SMS ───────────────────────────────────────────────
# Used by /api/send-bloom for recipient delivery texts and
# /api/twilio-inbound for inbound auto-replies.
# Phone: +1 (864) 528-3139 — provisioned 2026-05-06
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_FROM_NUMBER=+18645283139

# ── Order Alerts ─────────────────────────────────────────────
# AK's phone number for new-order SMS notifications.
AK_ALERT_PHONE=+1XXXXXXXXXX

# ── Setup Endpoint (one-time use only) ───────────────────────
# Used by /api/setup/create-products — delete after first use
SETUP_SECRET=change-this-to-a-random-string
