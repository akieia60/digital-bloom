{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "digitabloom.com" }
      ],
      "destination": "https://digitalbloom.store/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "www.digitabloom.com" }
      ],
      "destination": "https://digitalbloom.store/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/prompt-engine.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/process-bloom.js": { "maxDuration": 60, "memory": 3008 },
    "api/get-upload-url.js": { "maxDuration": 10 },
    "api/render-bloom.js": { "maxDuration": 60, "memory": 3008, "includeFiles": "api/_fonts/**" },
    "api/stripe/webhook.js": { "maxDuration": 60, "memory": 3008, "includeFiles": "api/_fonts/**" },
    "api/cron/retry-failed-renders.js": { "maxDuration": 300, "memory": 3008, "includeFiles": "api/_fonts/**" }
  },
  "crons": [
    {
      "path": "/api/cron/process-bloom-deliveries",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/buffer-marketing",
      "schedule": "0 13,16,19,22 * * *"
    },
    {
      "path": "/api/cron/smoke-test",
      "schedule": "0 */4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/marketing",
      "destination": "/marketing.html"
    },
    {
      "source": "/marketing.html",
      "destination": "/marketing.html"
    },
    {
      "source": "/go/:slug",
      "destination": "/api/go?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
